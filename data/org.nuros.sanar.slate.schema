[schema]
id = org.nuros.sanar.slate
path = /org/nuros/sanar/slate/

[theme]
type = s
default = material-you
summary = Look preset: material-you follows the Seurat color scheme, minimal, nord, gruvbox-dark, catppuccin-mocha, dracula, tokyo-night, light, a theme file of the user, or none

[color-scheme]
type = s
default = auto
choices = auto; light; dark
summary = Variant of the built in Material You palette that is used when Seurat is not running, auto follows Seurat and is dark without it

[mod-key]
type = s
default = auto
choices = auto; super; alt
summary = Modifier of the key bindings, auto is Super, or Alt in a nested Wayland window

[terminal]
type = s
default =
summary = Command started by Mod+Return, empty uses the environment variable TERMINAL and then foot or xterm

[workspace-count]
type = i
default = 9
min = 1
max = 9
summary = Number of workspaces

[border-width]
type = i
default = 2
min = 0
max = 32
summary = Window border width in pixels

[border-color-focused]
type = s
default = #6750a4
summary = Border color of the focused window as #rrggbb

[border-color-unfocused]
type = s
default = #49454f
summary = Border color of the other windows as #rrggbb

[xkb-rules]
type = s
default =
summary = XKB rules file, Wayland only, empty uses the XKB_DEFAULT_RULES environment variable

[xkb-model]
type = s
default =
summary = XKB keyboard model, Wayland only, empty uses the XKB_DEFAULT_MODEL environment variable

[xkb-layout]
type = s
default =
summary = Comma separated XKB layouts, Wayland only, empty uses the XKB_DEFAULT_LAYOUT environment variable

[xkb-variant]
type = s
default =
summary = Comma separated XKB variants, Wayland only, empty uses the XKB_DEFAULT_VARIANT environment variable

[xkb-options]
type = s
default =
summary = Comma separated XKB options such as grp:alt_shift_toggle, Wayland only

[repeat-delay]
type = i
default = 200
min = 10
max = 2000
summary = Delay in milliseconds before a held key repeats, Wayland only

[repeat-rate]
type = i
default = 25
min = 1
max = 200
summary = Key repeats per second, Wayland only

[cursor-theme]
type = s
default =
summary = Cursor theme, Wayland only, empty uses the environment variable XCURSOR_THEME and then default

[cursor-size]
type = i
default = 0
min = 0
max = 256
summary = Cursor size in pixels, Wayland only, 0 uses the environment variable XCURSOR_SIZE and then 24

[tap-to-click]
type = b
default = true
summary = Treat a tap on a touchpad as a click, Wayland on a TTY only

[natural-scroll]
type = b
default = false
summary = Reverse the scroll direction of touchpads and mice, Wayland on a TTY only

[decoration-mode]
type = s
default = server
choices = server; client; auto
summary = Who draws the window titlebars, server always asks for server side decorations, client for client side ones, auto follows the application. Wayland only

[decoration-rules]
type = as
default =
summary = Per application overrides as APP_ID=server, APP_ID=client or APP_ID=none, none removes the frame completely. Wayland only

[titlebar-height]
type = i
default = 30
min = 0
max = 96
summary = Height of the titlebar in pixels, 0 leaves only the border, Wayland only

[titlebar-color-focused]
type = s
default = #6750a4
summary = Titlebar color of the focused window as #rrggbb or #rrggbbaa, Wayland only

[titlebar-color-unfocused]
type = s
default = #49454f
summary = Titlebar color of the other windows as #rrggbb or #rrggbbaa, Wayland only

[title-color-focused]
type = s
default = #ffffff
summary = Title text color of the focused window, Wayland only

[title-color-unfocused]
type = s
default = #cac4d0
summary = Title text color of the other windows, Wayland only

[title-font]
type = s
default = sans-serif
summary = Comma separated fontconfig patterns or font file paths, later ones are used for missing glyphs, Wayland only

[title-font-size]
type = i
default = 13
min = 6
max = 64
summary = Title font size in pixels, Wayland only

[title-align]
type = s
default = center
choices = left; center; right
summary = Alignment of the title between the buttons, Wayland only

[title-padding]
type = i
default = 12
min = 0
max = 128
summary = Space between the title and the buttons or the titlebar edge in pixels, Wayland only

[corner-radius]
type = i
default = 8
min = 0
max = 32
summary = Radius of the upper corners of the titlebar in pixels, Wayland only

[resize-margin]
type = i
default = 4
min = 0
max = 32
summary = Width of the invisible area outside the frame that resizes the window in pixels, Wayland only

[button-layout]
type = s
default = :minimize,maximize,close
summary = Titlebar buttons as LEFT:RIGHT lists of close, maximize and minimize, for example close:minimize,maximize, Wayland only

[button-size]
type = i
default = 18
min = 8
max = 64
summary = Size of a titlebar button in pixels, Wayland only

[button-spacing]
type = i
default = 6
min = 0
max = 32
summary = Space between titlebar buttons in pixels, Wayland only

[button-margin]
type = i
default = 8
min = 0
max = 64
summary = Space between the titlebar edge and the buttons in pixels, Wayland only

[button-shape]
type = s
default = circle
choices = circle; rounded; square
summary = Shape of the button background, Wayland only

[button-color]
type = s
default = #00000000
summary = Button background color, Wayland only

[button-hover-color]
type = s
default = #ffffff33
summary = Button background color under the pointer, Wayland only

[button-close-hover-color]
type = s
default = #e5484d
summary = Background color of the close button under the pointer, Wayland only

[button-icon-color-focused]
type = s
default = #ffffff
summary = Button icon color in the focused window, Wayland only

[button-icon-color-unfocused]
type = s
default = #cac4d0
summary = Button icon color in the other windows, Wayland only

[titlebar-double-click]
type = s
default = maximize
choices = none; maximize; minimize; fullscreen; close
summary = Action of a double click on the titlebar, Wayland only

[titlebar-middle-click]
type = s
default = none
choices = none; maximize; minimize; fullscreen; close
summary = Action of a middle click on the titlebar, Wayland only

[titlebar-right-click]
type = s
default = none
choices = none; maximize; minimize; fullscreen; close
summary = Action of a right click on the titlebar, Wayland only

[bindings]
type = as
default =
summary = Key bindings as COMBO=ACTION that add to or replace the built in ones, for example Mod+b=exec firefox, and COMBO=none removes one

[layout]
type = s
default = floating
choices = floating; master-stack; spiral; grid; monocle
summary = Initial layout of every workspace, floating leaves the windows where they are, the others tile them

[tiling-gap]
type = i
default = 8
min = 0
max = 64
summary = Space between tiled windows in pixels

[tiling-outer-gap]
type = i
default = 8
min = 0
max = 128
summary = Space between tiled windows and the edge of the screen in pixels

[master-ratio]
type = i
default = 55
min = 10
max = 90
summary = Share of the screen in percent that the master area or the first split of the spiral takes

[master-count]
type = i
default = 1
min = 1
max = 8
summary = Number of windows in the master area

[floating-rules]
type = as
default =
summary = Application ids whose windows float even in a tiling layout
